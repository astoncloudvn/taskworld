{
  "name": "flowforge",
  "version": "1.0.0",
  "description": "A universal workflow and automation engine for Node.js and TypeScript",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "IMPLEMENTATION_REPORT.md",
    "examples"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pack": "npm pack"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "keywords": [
    "workflow",
    "automation",
    "workflow-engine",
    "task-runner",
    "typescript",
    "nodejs",
    "scheduler",
    "event-driven"
  ],
  "author": ""
}